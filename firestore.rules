rules_version = '2';

// CampusPulse — Cloud Firestore security rules
//
// Three kinds of caller reach Firestore:
//   1. The Flutter student app, signed in with Firebase Auth.
//   2. The in-browser code of the driver PWA and admin console, which does not use
//      Firebase Auth. It is indistinguishable from an anonymous caller, so whatever
//      it needs is granted to everyone, limited to the exact fields it writes.
//   3. Cloud Functions, the PHP backend and admin scripts. They use the Admin SDK
//      and bypass these rules entirely.
//
// Known limitations that need code changes rather than rule changes:
//   - Campus Credits balances are written by the client, so a student can credit
//     their own wallet. Moving top-ups and fares into Cloud Functions would fix it.
//   - Until the driver PWA signs in, the operational data it reads (shuttle positions,
//     schedules, open ride requests, ratings) stays publicly readable, and its
//     live-trip fields stay publicly writable.
//   - Verified students can read Staffs, which includes password hashes. The app only
//     needs driver names; a public driver-profile collection would remove the need.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Anyone can create a Firebase Auth account with the public API key, but only a
    // real student can verify an @s.unikl.edu.my address.
    function isStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@s[.]unikl[.]edu[.]my$');
    }

    function ownsExisting() {
      return isStudent() && resource.data.user_id == request.auth.uid;
    }

    function ownsIncoming() {
      return isStudent() && request.resource.data.user_id == request.auth.uid;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // Written by the driver PWA during a live trip (driver/active_trip.php).
    function isLiveTripUpdate() {
      return onlyChanges(['current_stop_index', 'live_eta', 'live_eta_updated_at', 'trip_logs']);
    }

    // A seat is taken or released one at a time, never beyond capacity.
    function isSeatChange() {
      let before = resource.data.get('booked_count', 0);
      let after = request.resource.data.booked_count;
      return after is int && (
        (after == before + 1 && after <= resource.data.get('capacity', 13))
        || after == before - 1
        || (after == 0 && before <= 0)
      );
    }

    // Not gated on verification: registration, the verification screen and push-token
    // saving all run before the student has verified their email.
    match /Students/{uid} {
      allow read, create, update, delete: if signedInAs(uid);
    }

    match /Bookings/{bookingId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.status in ['confirmed', 'searching'];
      // Students may cancel, expire, resend and rate; every other status change comes
      // from the driver PWA's PHP backend.
      allow update: if ownsExisting()
        && request.resource.data.user_id == resource.data.user_id
        && onlyChanges(['status', 'is_no_show', 'cancellation_reason', 'cancelled_at',
                        'is_rated', 'request_time', 'booking_time'])
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status in ['searching', 'expired', 'expired_acknowledged',
                                                'cancelled', 'missed']);

      // Driver PWA: the incoming-request listener, and the booking being driven.
      // Booking ids are random, so `get` does not let anyone enumerate bookings.
      allow list: if resource.data.status == 'searching';
      allow get: if true;
      allow update: if isLiveTripUpdate();
    }

    match /Schedules/{scheduleId} {
      allow read: if true;
      allow update: if isStudent() && onlyChanges(['booked_count']) && isSeatChange();
      allow update: if isLiveTripUpdate();
    }

    match /Transactions/{txnId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
    }

    match /Ratings/{ratingId} {
      // The driver PWA's trip history reads ratings without signing in.
      allow read: if true;
      allow create: if ownsIncoming()
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && get(/databases/$(database)/documents/Bookings/$(request.resource.data.booking_id)).data.user_id
           == request.auth.uid;
    }

    match /Notifications/{notifId} {
      allow read: if ownsExisting();
      allow update: if ownsExisting() && onlyChanges(['is_read']);
      // The driver PWA listens for its driver's notifications without signing in.
      allow list: if resource.data.user_id is string
        && resource.data.user_id.matches('^DRV[0-9]+$');
    }

    match /Timetable/{entryId} {
      allow read: if ownsExisting();
    }

    // Holds login password hashes, so it is never public.
    match /Staffs/{staffId} {
      allow read: if isStudent();
      // The driver PWA clears the current trip when a ride finishes.
      allow update: if onlyChanges(['current_trip_id'])
        && request.resource.data.current_trip_id == '';
    }

    match /Shuttles/{shuttleId} {
      allow read: if true;
      // Driver PWA: the GPS heartbeat, and releasing the van when a ride finishes.
      allow update: if onlyChanges(['current_lat', 'current_lng', 'is_online', 'last_updated', 'job_status'])
        && request.resource.data.get('is_online', false) is bool
        && (request.resource.data.get('job_status', '') == resource.data.get('job_status', '')
            || request.resource.data.job_status == 'idle');
    }

    match /Zones/{zoneId}          { allow read: if true; }
    match /Routes/{routeId}        { allow read: if true; }
    match /Stops/{stopId}          { allow read: if true; }
    match /Announcements/{notice}  { allow read: if true; }

    // Anything not matched above (Counters, DRIVER_APPLICATIONS, ...) is server-only.
  }
}
